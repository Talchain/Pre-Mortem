# AI Provider API Keys
# Note: You only need to set the API key for the provider you plan to use

# Anthropic API Key for Claude models
# Get your API key from: https://console.anthropic.com/
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key for GPT models
# Get your API key from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# App Version
VITE_APP_VERSION=2.0.0

# Scenario Sandbox Integration
VITE_ENABLE_SCENARIO_SANDBOX_INTEGRATION=false
VITE_SCENARIO_SANDBOX_API_URL=http://localhost:3000/api

# Development
VITE_DEBUG_MODE=false
VITE_MOCK_AI_RESPONSES=false

# Optional: Analytics ID
VITE_ANALYTICS_ID=
